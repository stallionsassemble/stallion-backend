# Database
DATABASE_URL="postgresql://user:password@localhost:5432/stallion_db?schema=public"

# Redis (for passkey challenge storage and job queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Soroban (Stellar)
SOROBAN_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_CONTRACT_ID=CBSPZEBFRRVY3X6M4JVXF6F7DAMSDXTM5DPBYXBRPFXNYSVJQVPGCGPC
SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Master Account (stores all user funds)
# This account's keys should be encrypted with KMS in production
MASTER_ACCOUNT_PUBLIC_KEY=your-master-account-public-key
MASTER_ACCOUNT_SECRET_KEY_ENCRYPTED=your-encrypted-secret-key

# AWS KMS (for production key management)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_KMS_KEY_ID=your-kms-key-id

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Encryption (for TOTP secrets and sensitive data)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-character-hex-key-change-in-production

# WebAuthn (Passkeys)
RP_ID=localhost
ORIGIN=http://localhost:3000

# App
PORT=3000
NODE_ENV=development
APP_NAME=Stallion
APP_URL=http://localhost:3000

# Admin Users (comma-separated user IDs)
ADMIN_USER_IDS=

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@stallion.com

# Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
