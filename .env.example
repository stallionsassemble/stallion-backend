# Database
DATABASE_URL="postgresql://user:password@localhost:5432/stallion_db?schema=public"

# Redis (for passkey challenge storage and job queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Soroban (Stellar)
SOROBAN_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_CONTRACT_ID=CBSPZEBFRRVY3X6M4JVXF6F7DAMSDXTM5DPBYXBRPFXNYSVJQVPGCGPC
SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Master Account (for reference/admin operations)
MASTER_PUBLIC_KEY=your-master-account-public-key

# Vault KMS (for production key management)
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=root
VAULT_STELLAR_SEED_PATH=secret/stellar-wallet
VAULT_TRANSIT_KEY=stallion-key

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Encryption (for TOTP secrets and sensitive data)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-character-hex-key-change-in-production

# WebAuthn (Passkeys)
RP_ID=localhost
ORIGIN=http://localhost:3000

# App
PORT=3000
NODE_ENV=development
APP_NAME=Stallion
APP_URL=http://localhost:3000

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@stallion.com

# Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
