# Database
DATABASE_URL="postgresql://user:password@localhost:5432/stallion_db?schema=public"

# Redis (for passkey challenge storage and job queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=default
REDIS_DB=0

# Soroban (Stellar)
SOROBAN_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_CONTRACT_ID=CBSPZEBFRRVY3X6M4JVXF6F7DAMSDXTM5DPBYXBRPFXNYSVJQVPGCGPC
SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Funding wallet fallback (deprecated; admin setting takes precedence)
FUNDING_WALLET_ID=

# JWT
JWT_SECRET=your-secret-key-change-in-production
REFRESH_TOKEN_SECRET=your-refresh-token-secret-change-in-production
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Encryption (for TOTP secrets and sensitive data)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-character-hex-key-change-in-production

# WebAuthn (Passkeys)
RP_ID=localhost
ORIGIN=http://localhost:3000

# Social auth
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Admin step-up
ADMIN_STEP_UP_TTL_SECONDS=600

# App
PORT=5002
NODE_ENV=development
APP_NAME=Stallion
BASE_URL=http://localhost:5002
FRONTEND_URL=http://localhost:3000

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@stallion.com

# Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# FCM
FIREBASE_SERVICE_ACCOUNT_PATH=
