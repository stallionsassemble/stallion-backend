generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String?  @unique
  
  // Profile fields - common
  firstName String?  @map("first_name")
  lastName  String?  @map("last_name")
  location  String?
  skills    String[] @default([])
  profilePicture String? @map("profile_picture")
  socials   Json?    // { linkedin: 'url', github: 'url', twitter: 'url' }
  
  // Role-specific fields
  role      Role     @default(CONTRIBUTOR)
  
  // Project Owner specific
  companyName     String? @map("company_name")
  entityName      String? @map("entity_name")
  phoneNumber     String? @map("phone_number")
  industry        String?
  companyBio      String? @map("company_bio")
  companyLogo     String? @map("company_logo")
  
  // Settings
  emailNotifications Boolean @default(true) @map("email_notifications")
  
  // Profile completion status
  profileCompleted Boolean @default(false) @map("profile_completed")
  
  // MFA fields
  totpSecret      String?  @map("totp_secret")
  totpEnabled     Boolean  @default(false) @map("totp_enabled")
  backupCodes     String[] @default([]) @map("backup_codes")
  
  // Refresh token
  refreshToken    String?  @map("refreshToken")
  
  // Verification
  emailVerified   Boolean  @default(false) @map("email_verified")
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  wallet      Wallet?            @relation(fields: [walletId], references: [id], onDelete: Restrict)
  walletId    String?            @unique @map("wallet_id")
  userPoints  UserPoint?
  reputation  UserReputation?
  submissions BountySubmission[]
  winners     BountyWinner[]
  bounties    Bounty[]
  passkeys    Passkey[]
  
  // Forum relations
  forumThreads   ForumThread[]
  forumPosts     ForumPost[]
  forumReactions ForumReaction[]
  
  // Chat relations
  conversationParticipants ConversationParticipant[]
  messages                 Message[]
  messageReadReceipts      MessageReadReceipt[]
  
  // Notification relations
  notifications        Notification[]
  notificationSettings NotificationSettings?
  fcmTokens            FcmToken[]
  
  // Hackathon relations
  hackathons           Hackathon[]
  hackathonSubmissions HackathonSubmission[]
  hackathonWinners     HackathonWinner[]

  @@index([role])
  @@index([createdAt])
  @@index([username])
  @@index([emailVerified])
  @@map("users")
}

model Passkey {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  credentialId      String   @unique @map("credential_id")
  publicKey         String   @map("public_key")
  counter           BigInt   @default(0)
  deviceType        String   @map("device_type")
  backedUp          Boolean  @default(false) @map("backed_up")
  transports        String[] @default([])
  
  name              String?  // User-friendly name for the passkey
  lastUsedAt        DateTime? @map("last_used_at")
  
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([credentialId])
  @@map("passkeys")
}


model UserPoint {
  id        String   @id @default(cuid())
  total     Int      @default(0)
  points    Point[]
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([total(sort: Desc)])
  @@map("user_points")
}

model Point {
  id        String   @id @default(cuid())
  amount    Int
  action    String
  note      String?
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  userPointId String    @map("user_point_id")
  userPoint   UserPoint @relation(fields: [userPointId], references: [id], onDelete: Cascade)

  @@index([userPointId, createdAt(sort: Desc)])
  @@index([action])
  @@map("points")
}

model UserReputation {
  id                String              @id @default(cuid())
  score             Int                 @default(0) // Overall reputation score
  level             ReputationLevel     @default(NEWCOMER)
  
  // Reputation breakdown
  bountyScore       Int                 @default(0) @map("bounty_score")
  hackathonScore    Int                 @default(0) @map("hackathon_score")
  communityScore    Int                 @default(0) @map("community_score")
  
  // Statistics
  totalBounties     Int                 @default(0) @map("total_bounties")
  wonBounties       Int                 @default(0) @map("won_bounties")
  totalHackathons   Int                 @default(0) @map("total_hackathons")
  wonHackathons     Int                 @default(0) @map("won_hackathons")
  forumPosts        Int                 @default(0) @map("forum_posts")
  helpfulVotes      Int                 @default(0) @map("helpful_votes")
  
  // Badges
  badges            String[]            @default([])
  
  updatedAt         DateTime            @updatedAt @map("updated_at")
  createdAt         DateTime            @default(now()) @map("created_at")

  // Relations
  userId            String              @unique @map("user_id")
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  history           ReputationHistory[]

  @@index([score(sort: Desc)])
  @@index([level])
  @@map("user_reputations")
}

model ReputationHistory {
  id          String   @id @default(cuid())
  change      Int      // Positive or negative change
  reason      String
  category    ReputationCategory
  metadata    Json?    // Additional context
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  reputationId String         @map("reputation_id")
  reputation   UserReputation @relation(fields: [reputationId], references: [id], onDelete: Cascade)

  @@index([reputationId, createdAt(sort: Desc)])
  @@index([category])
  @@map("reputation_history")
}

model Bounty {
  id                 String       @id @default(cuid())
  title              String
  shortDescription   String?      @map("short_description")
  description        String?
  reward             String       @default("0") // Stored as string for large numbers
  token              String?      // Token contract address
  rewardCurrency     String?      @map("reward_currency")
  rewardDistribution Json?        @map("reward_distribution")
  submissionFields   Json?        @map("submission_fields")
  status             BountyStatus @default(ACTIVE)
  contractBountyId   Int?         @unique @map("contract_bounty_id") // ID from Soroban contract
  txHash             String?      @map("tx_hash") // Transaction hash from Soroban
  submissionDeadline DateTime?    @map("submission_deadline")
  judgingDeadline    DateTime?    @map("judging_deadline")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  ownerId     String             @map("owner_id")
  owner       User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  submissions BountySubmission[]
  winners     BountyWinner[]

  @@index([status, createdAt(sort: Desc)])
  @@index([ownerId])
  @@index([createdAt(sort: Desc)])
  @@index([contractBountyId])
  @@map("bounties")
}

model BountySubmission {
  id             String           @id @default(cuid())
  submission     Json?
  submissionLink String?          @map("submission_link") // Link to submission
  status         SubmissionStatus @default(PENDING)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  // Relations
  userId   String @map("user_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  bountyId String @map("bounty_id")
  bounty   Bounty @relation(fields: [bountyId], references: [id], onDelete: Cascade)

  @@index([bountyId, status])
  @@index([userId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("bounty_submissions")
}

model BountyWinner {
  id        String    @id @default(cuid())
  position  Int
  awardedAt DateTime? @map("awarded_at")

  // Relations
  userId   String @map("user_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  bountyId String @map("bounty_id")
  bounty   Bounty @relation(fields: [bountyId], references: [id], onDelete: Cascade)

  @@unique([bountyId, userId])
  @@index([userId])
  @@index([bountyId])
  @@map("bounty_winners")
}

model Wallet {
  id        String   @id @default(cuid())
  memoId    String   @unique @map("memo_id")
  balance   Decimal  @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  users        User[]
  transactions Transaction[]

  @@map("wallets")
}

model Transaction {
  id             String   @id @default(cuid())
  type           TxType
  amount         Decimal
  currency       String
  state          TxState  @default(PENDING)
  externalTxId   String?  @map("external_tx_id")
  idempotencyKey String?  @unique @map("idempotency_key")
  note           String?
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  walletId String @map("wallet_id")

  @@index([walletId, createdAt(sort: Desc)])
  @@index([walletId, state, type])
  @@index([externalTxId, type])
  @@index([state])
  @@index([type])
  @@map("transactions")
}

model LedgerLock {
  id        String    @id @default(cuid())
  walletId  String    @map("wallet_id")
  reason    String
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([walletId])
  @@index([expiresAt])
  @@map("ledger_locks")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@index([action])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

enum Role {
  CONTRIBUTOR
  PROJECT_OWNER
  ADMIN
}

enum TxType {
  DEPOSIT
  WITHDRAWAL
  PAYOUT
  REFUND
  FEE
}

enum TxState {
  PENDING
  COMPLETED
  FAILED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BountyStatus {
  ACTIVE
  COMPLETED
  CLOSED
}

// ============================================
// FORUM MODELS
// ============================================

model ForumCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  order       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  threads ForumThread[]

  @@index([slug])
  @@index([order])
  @@map("forum_categories")
}

model ForumThread {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  isPinned    Boolean      @default(false) @map("is_pinned")
  isLocked    Boolean      @default(false) @map("is_locked")
  viewCount   Int          @default(0) @map("view_count")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  categoryId  String       @map("category_id")
  category    ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  authorId    String       @map("author_id")
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  posts       ForumPost[]
  tags        ForumThreadTag[]

  @@index([categoryId, isPinned, updatedAt(sort: Desc)])
  @@index([authorId])
  @@index([slug])
  @@index([createdAt(sort: Desc)])
  @@map("forum_threads")
}

model ForumPost {
  id        String   @id @default(cuid())
  content   String
  isEdited  Boolean  @default(false) @map("is_edited")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  threadId  String   @map("thread_id")
  thread    ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  
  authorId  String   @map("author_id")
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  reactions ForumReaction[]

  @@index([threadId, createdAt])
  @@index([authorId])
  @@map("forum_posts")
}

model ForumReaction {
  id        String   @id @default(cuid())
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")

  postId    String   @map("post_id")
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, emoji])
  @@index([postId])
  @@index([userId])
  @@map("forum_reactions")
}

model ForumTag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  color     String?
  createdAt DateTime @default(now()) @map("created_at")

  threads   ForumThreadTag[]

  @@index([slug])
  @@map("forum_tags")
}

model ForumThreadTag {
  threadId  String      @map("thread_id")
  thread    ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  
  tagId     String      @map("tag_id")
  tag       ForumTag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([threadId, tagId])
  @@map("forum_thread_tags")
}

// ============================================
// CHAT MODELS
// ============================================

model Conversation {
  id            String           @id @default(cuid())
  type          ConversationType @default(DIRECT)
  name          String?
  avatar        String?
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  participants  ConversationParticipant[]
  messages      Message[]

  @@index([type])
  @@index([updatedAt(sort: Desc)])
  @@map("conversations")
}

model ConversationParticipant {
  id              String       @id @default(cuid())
  role            ParticipantRole @default(MEMBER)
  lastReadAt      DateTime?    @map("last_read_at")
  joinedAt        DateTime     @default(now()) @map("joined_at")
  leftAt          DateTime?    @map("left_at")
  
  conversationId  String       @map("conversation_id")
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  userId          String       @map("user_id")
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
  @@map("conversation_participants")
}

model Message {
  id              String       @id @default(cuid())
  content         String
  type            MessageType  @default(TEXT)
  attachments     Json?
  isEdited        Boolean      @default(false) @map("is_edited")
  isDeleted       Boolean      @default(false) @map("is_deleted")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  conversationId  String       @map("conversation_id")
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  senderId        String       @map("sender_id")
  sender          User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  readReceipts    MessageReadReceipt[]

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([senderId])
  @@map("messages")
}

model MessageReadReceipt {
  id        String   @id @default(cuid())
  readAt    DateTime @default(now()) @map("read_at")

  messageId String   @map("message_id")
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
  @@map("message_read_receipts")
}

// ============================================
// ENUMS
// ============================================

enum ConversationType {
  DIRECT
  GROUP
}

enum ParticipantRole {
  ADMIN
  MEMBER
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}

// ============================================
// NOTIFICATION MODELS
// ============================================

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  data      Json?
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([userId, type])
  @@map("notifications")
}

model NotificationSettings {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Chat notifications
  chatInApp   Boolean @default(true) @map("chat_in_app")
  chatEmail   Boolean @default(true) @map("chat_email")
  
  // Wallet notifications
  walletInApp Boolean @default(true) @map("wallet_in_app")
  walletEmail Boolean @default(true) @map("wallet_email")
  
  // Bounty notifications
  bountyInApp Boolean @default(true) @map("bounty_in_app")
  bountyEmail Boolean @default(true) @map("bounty_email")
  
  // Forum notifications
  forumInApp  Boolean @default(true) @map("forum_in_app")
  forumEmail  Boolean @default(false) @map("forum_email")
  
  // System notifications
  systemInApp Boolean @default(true) @map("system_in_app")
  systemEmail Boolean @default(true) @map("system_email")
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("notification_settings")
}

model FcmToken {
  id        String   @id @default(cuid())
  token     String   @unique
  deviceId  String?  @map("device_id")
  platform  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("fcm_tokens")
}

// ============================================
// NOTIFICATION ENUMS
// ============================================

enum NotificationType {
  // Chat notifications
  NEW_MESSAGE
  NEW_CONVERSATION
  MENTION
  
  // Wallet notifications
  DEPOSIT_RECEIVED
  WITHDRAWAL_COMPLETED
  WITHDRAWAL_FAILED
  
  // Bounty notifications
  BOUNTY_CREATED
  SUBMISSION_RECEIVED
  SUBMISSION_APPROVED
  SUBMISSION_REJECTED
  BOUNTY_WINNER
  PAYOUT_RECEIVED
  
  // Forum notifications
  THREAD_REPLY
  POST_REACTION
  THREAD_MENTION
  
  // System notifications
  SYSTEM_ANNOUNCEMENT
  ACCOUNT_UPDATE
  
  // Hackathon notifications
  HACKATHON_CREATED
  HACKATHON_STARTING_SOON
  HACKATHON_SUBMISSION_RECEIVED
  HACKATHON_WINNER_ANNOUNCED
}

// ============================================
// HACKATHON MODELS
// ============================================

model Hackathon {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String   @db.Text
  
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  
  totalReward Decimal  @map("total_reward") @db.Decimal(20, 7)
  currency    String   @default("XLM")
  
  // Settings
  allowMultipleTrackSubmissions Boolean @default(false) @map("allow_multiple_track_submissions")
  maxSubmissionsPerUser         Int     @default(1) @map("max_submissions_per_user")
  
  // Metadata
  coverImage  String?  @map("cover_image")
  rules       String?  @db.Text
  prizes      Json?    // Additional prize information
  
  status      HackathonStatus @default(DRAFT)
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  ownerId     String   @map("owner_id")
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  
  tracks      HackathonTrack[]
  submissions HackathonSubmission[]
  winners     HackathonWinner[]
  
  @@index([ownerId])
  @@index([status, startDate])
  @@index([slug])
  @@map("hackathons")
}

model HackathonTrack {
  id          String   @id @default(cuid())
  name        String
  description String   @db.Text
  
  prizePool   Decimal  @map("prize_pool") @db.Decimal(20, 7)
  
  // Reward distribution (e.g., [50, 30, 20] for 1st, 2nd, 3rd place percentages)
  rewardDistribution Json @map("reward_distribution")
  
  // Submission requirements
  submissionFields Json @map("submission_fields") // Array of field definitions
  
  // Track settings
  maxSubmissions Int?   @map("max_submissions") // Max submissions for this track
  isMainTrack    Boolean @default(false) @map("is_main_track")
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  hackathonId String   @map("hackathon_id")
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  
  submissions HackathonSubmission[]
  winners     HackathonWinner[]
  
  @@index([hackathonId])
  @@index([hackathonId, isMainTrack])
  @@map("hackathon_tracks")
}

model HackathonSubmission {
  id          String   @id @default(cuid())
  
  // Submission data based on track's submissionFields
  submissionData Json   @map("submission_data")
  
  // Additional metadata
  projectName    String? @map("project_name")
  projectUrl     String? @map("project_url")
  repositoryUrl  String? @map("repository_url")
  videoUrl       String? @map("video_url")
  description    String? @db.Text
  
  status      HackathonSubmissionStatus @default(PENDING)
  
  // Judging
  score       Decimal? @db.Decimal(10, 2)
  feedback    String?  @db.Text
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  submittedAt DateTime @default(now()) @map("submitted_at")
  
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  hackathonId String   @map("hackathon_id")
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  
  trackId     String   @map("track_id")
  track       HackathonTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  
  winner      HackathonWinner?
  
  @@unique([userId, hackathonId, trackId])
  @@index([userId])
  @@index([hackathonId, status])
  @@index([trackId, status])
  @@map("hackathon_submissions")
}

model HackathonWinner {
  id          String   @id @default(cuid())
  
  position    Int      // 1st, 2nd, 3rd, etc.
  prizeAmount Decimal  @map("prize_amount") @db.Decimal(20, 7)
  
  // Payout tracking
  isPaid      Boolean  @default(false) @map("is_paid")
  paidAt      DateTime? @map("paid_at")
  txHash      String?  @map("tx_hash")
  
  createdAt   DateTime @default(now()) @map("created_at")
  
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  
  hackathonId String   @map("hackathon_id")
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Restrict)
  
  trackId     String   @map("track_id")
  track       HackathonTrack @relation(fields: [trackId], references: [id], onDelete: Restrict)
  
  submissionId String  @unique @map("submission_id")
  submission   HackathonSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  
  @@unique([hackathonId, trackId, position])
  @@index([userId])
  @@index([hackathonId])
  @@index([trackId])
  @@map("hackathon_winners")
}

