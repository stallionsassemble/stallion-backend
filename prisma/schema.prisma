// ============================================
// HACKATHON MODELS
// ============================================

model Hackathon {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String   @db.Text
  type        HackathonType
  deliverables String[] @default([])
  tags         String[] @default([])

  deadline         DateTime
  announcementDate DateTime @map("announcement_date")

  totalBudget Decimal @map("total_budget") @db.Decimal(20, 7)
  token       String
  asset       String
  currency    String  @default("XLM")
  prizePool   Json    @map("prize_pool")

  documents   Json?
  attachments Json?

  teamBased   Boolean @default(false) @map("team_based")
  maxTeamSize Int?    @map("max_team_size")

  status           HackathonStatus @default(DRAFT)
  resultsPublished Boolean         @default(false) @map("results_published")

  // Smart contract fields
  contractHackathonId Int?    @unique @map("contract_hackathon_id")
  txHash              String? @map("tx_hash")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  createdById String @map("created_by_id")
  createdBy   User   @relation("HackathonCreator", fields: [createdById], references: [id], onDelete: Restrict)

  companyId String @map("company_id")
  company   User   @relation("HackathonCompany", fields: [companyId], references: [id], onDelete: Restrict)

  submissions  HackathonSubmission[]
  winners      HackathonWinner[]
  teams        HackathonTeam[]
  participants HackathonParticipant[]
  activities   Activity[]

  @@index([createdById])
  @@index([companyId])
  @@index([status, deadline])
  @@index([slug])
  @@map("hackathons")
}

model HackathonTeam {
  id   String @id @default(cuid())
  name String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  hackathonId String    @map("hackathon_id")
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)

  leaderId    String    @map("leader_id")
  leader      User      @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: Restrict)

  participants HackathonParticipant[]
  submissions  HackathonSubmission[]

  @@unique([hackathonId, name])
  @@index([hackathonId])
  @@index([leaderId])
  @@map("hackathon_teams")
}

model HackathonParticipant {
  id String @id @default(cuid())

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  hackathonId String    @map("hackathon_id")
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)

  teamId String?        @map("team_id")
  team   HackathonTeam? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([userId, hackathonId])
  @@index([userId])
  @@index([hackathonId])
  @@index([teamId])
  @@map("hackathon_participants")
}

model HackathonSubmission {
  id String @id @default(cuid())

  title          String
  submissionLink String @map("submission_link")
  description    String? @db.Text
  
  // Custom submission data if needed
  submissionData Json?   @map("submission_data")
  projectName    String? @map("project_name")
  projectUrl     String? @map("project_url")
  repositoryUrl  String? @map("repository_url")
  videoUrl       String? @map("video_url")

  status HackathonSubmissionStatus @default(PENDING)

  // Judging
  score    Decimal? @db.Decimal(10, 2)
  feedback String?  @db.Text

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  submittedAt DateTime @default(now()) @map("submitted_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  hackathonId String    @map("hackathon_id")
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)

  teamId String?        @map("team_id")
  team   HackathonTeam? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  winner HackathonWinner?

  @@index([userId])
  @@index([hackathonId, status])
  @@index([teamId])
  @@map("hackathon_submissions")
}

model HackathonWinner {
  id String @id @default(cuid())

  position    Int // 1st, 2nd, 3rd, etc.
  prizeAmount Decimal @map("prize_amount") @db.Decimal(20, 7)
  feedback    String? @db.Text

  // Payout tracking
  isPaid Boolean   @default(false) @map("is_paid")
  paidAt DateTime? @map("paid_at")
  txHash String?   @map("tx_hash")

  createdAt DateTime @default(now()) @map("created_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  hackathonId String    @map("hackathon_id")
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Restrict)

  submissionId String              @unique @map("submission_id")
  submission   HackathonSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)

  @@unique([hackathonId, position])
  @@index([userId])
  @@index([hackathonId])
  @@map("hackathon_winners")
}

model SocialAccount {
  id              String         @id @default(cuid())
  provider        SocialProvider
  providerSubject String         @map("provider_subject")
  email           String
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@index([email])
  @@map("social_accounts")
}

model PlatformSetting {
  id              String   @id @default("global")
  fundingWalletId String?  @map("funding_wallet_id")
  updatedByUserId String?  @map("updated_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  updatedByUser User? @relation("FundingWalletUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
  @@map("platform_settings")
}

