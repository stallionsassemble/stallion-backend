// ============================================
// PROJECT MODELS
// ============================================

model Project {
  id               String      @id @default(cuid())
  title            String
  shortDescription String      @map("short_description")
  description      String      @db.Text
  requirements     String[]    @default([])
  deliverables     String[]    @default([])
  skills           String[]    @default([])
  attachments      Json? // Array of attachment objects: [{filename, url, size, mimetype}]
  reward           String      @default("0") // Stored as string for large numbers
  currency         String
  deadline         DateTime
  status           ProjectStatus @default(OPEN)
  isFeatured       Boolean       @default(false) @map("is_featured")
  type             ProjectType
  peopleNeeded     Int         @default(1) @map("people_needed") // Number of positions available

  // Smart contract fields (GIG only)
  contractProjectId Int?      @unique @map("contract_project_id") // ID from Soroban contract
  txHash            String?   @map("tx_hash") // Transaction hash from Soroban
  escrowContractId  String?   @map("escrow_contract_id") // Escrow contract ID for GIG

  // Tracking
  acceptedCount Int @default(0) @map("accepted_count") // Number of accepted contributors

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  ownerId      String               @map("owner_id")
  owner        User                 @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  applications ProjectApplication[]
  milestones   ProjectMilestone[]
  activities Activity[]
  discussions  ProjectDiscussion[]
  payouts      Payout[]

  @@index([status, createdAt(sort: Desc)])
  @@index([type, status])
  @@index([ownerId])
  @@index([createdAt(sort: Desc)])
  @@index([deadline])
  @@map("projects")
}

model ProjectApplication {
  id                    String                @id @default(cuid())
  coverLetter           String                @db.Text
  estimatedCompletionTime Int?                @map("estimated_completion_time") // In days, required for GIG
  portfolioLinks        String[]              @default([]) @map("portfolio_links")
  attachments           Json? // Array of attachment objects
  status                ApplicationStatus     @default(PENDING)
  rejectionReason       String?               @map("rejection_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  userMilestones UserMilestone[]

  @@unique([projectId, userId])
  @@index([projectId, status])
  @@index([userId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("project_applications")
}

model ProjectMilestone {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  amount      String   @default("0") // Stored as string for large numbers
  dueDate     DateTime @map("due_date")
  order       Int // Order of milestone in the project

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  projectId      String            @map("project_id")
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userMilestones UserMilestone[]

  @@index([projectId])
  @@index([dueDate])
  @@map("project_milestones")
}

model UserMilestone {
  id     String          @id @default(cuid())
  status MilestoneStatus @default(PENDING)

  // Submission
  description String?   @db.Text
  links       String[]  @default([])
  attachments Json?
  submittedAt DateTime? @map("submitted_at")

  // Review
  reviewNote   String?   @map("review_note") @db.Text
  reviewedAt   DateTime? @map("reviewed_at")
  revisionNote String?   @map("revision_note") @db.Text

  // Payment
  txHash               String?   @map("tx_hash") // Transaction hash from payment
  paidAt               DateTime? @map("paid_at")
  usdValueAtCompletion Decimal?  @map("usd_value_at_completion") @db.Decimal(20, 7)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  milestoneId String           @map("milestone_id")
  milestone   ProjectMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  applicationId String             @map("application_id")
  application   ProjectApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  contributorId String @map("contributor_id")
  contributor   User   @relation("UserMilestones", fields: [contributorId], references: [id], onDelete: Cascade)
  payout        Payout?

  @@unique([milestoneId, applicationId])
  @@index([milestoneId])
  @@index([applicationId])
  @@index([contributorId])
  @@index([status])
  @@map("user_milestones")
}

model Payout {
  id           String           @id @default(cuid())
  sourceType   PayoutSourceType @map("source_type")
  sourceId     String           @map("source_id")
  token        String
  amount       Decimal          @db.Decimal(20, 7)
  usdAmount    Decimal?         @map("usd_amount") @db.Decimal(20, 7)
  status       PayoutStatus     @default(PENDING_APPROVAL)
  requestedAt  DateTime         @default(now()) @map("requested_at")
  completedAt  DateTime?        @map("completed_at")
  failedAt     DateTime?        @map("failed_at")
  txHash       String?          @map("tx_hash")
  errorMessage String?          @map("error_message")
  retryCount   Int              @default(0) @map("retry_count")
  lastRetryAt  DateTime?        @map("last_retry_at")
  metadata     Json?
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  contributorId String @map("contributor_id")
  contributor   User   @relation("PayoutContributor", fields: [contributorId], references: [id], onDelete: Cascade)

  bountyId String? @map("bounty_id")
  bounty   Bounty? @relation(fields: [bountyId], references: [id], onDelete: SetNull)

  projectId String?  @map("project_id")
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  bountyWinnerId String?       @unique @map("bounty_winner_id")
  bountyWinner   BountyWinner? @relation(fields: [bountyWinnerId], references: [id], onDelete: SetNull)

  userMilestoneId String?        @unique @map("user_milestone_id")
  userMilestone   UserMilestone? @relation(fields: [userMilestoneId], references: [id], onDelete: SetNull)

  @@unique([sourceType, sourceId])
  @@index([status, requestedAt(sort: Desc)])
  @@index([token])
  @@index([contributorId])
  @@index([bountyId])
  @@index([projectId])
  @@map("payouts")
}

model Activity {
  id       String       @id @default(cuid())
  type     ActivityType
  message  String
  metadata Json? // Additional context about the activity (amounts, names, etc.)

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Optional references to specific entities
  bountyId    String?  @map("bounty_id")
  bounty      Bounty?  @relation(fields: [bountyId], references: [id], onDelete: Cascade)
  projectId   String?  @map("project_id")
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  hackathonId String?  @map("hackathon_id")
  hackathon   Hackathon? @relation(fields: [hackathonId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([bountyId, createdAt(sort: Desc)])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([hackathonId, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("activities")
}

// ============================================
// PROJECT ENUMS
// ============================================

enum ProjectType {
  GIG // Milestone-based, paid via smart contract
  JOB // Opportunity listing, no escrow
}

enum ProjectStatus {
  OPEN // Accepting applications
  IN_PROGRESS // Work in progress (GIG only, locked to contributor)
  COMPLETED // All work completed
  CANCELLED // Cancelled by owner
  CLOSED // Closed without completion
}

enum ApplicationStatus {
  PENDING // Awaiting review
  ACCEPTED // Accepted by owner
  REJECTED // Rejected by owner
  WITHDRAWN // Withdrawn by applicant
}

enum MilestoneStatus {
  PENDING // Not yet started
  IN_PROGRESS // Being worked on
  SUBMITTED // Submitted for review
  REVISION_REQUESTED // Owner requested changes
  APPROVED // Approved by owner
  PAID // Payment released
}

enum ActivityType {
  // Bounty activities
  BOUNTY_CREATED
  BOUNTY_SUBMISSION
  BOUNTY_WON
  BOUNTY_COMPLETED
  
  // Project activities
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_WON
  PROJECT_APPLICATION_SUBMITTED
  PROJECT_APPLICATION_ACCEPTED
  PROJECT_APPLICATION_REJECTED
  PROJECT_MILESTONE_SUBMITTED
  PROJECT_MILESTONE_APPROVED
  PROJECT_MILESTONE_PAID
  PROJECT_COMPLETED
  PROJECT_CANCELLED
  
  // Hackathon activities
  HACKATHON_CREATED
  HACKATHON_SUBMISSION
  HACKATHON_WON
  HACKATHON_COMPLETED
  
  // Forum activities
  FORUM_THREAD_CREATED
  FORUM_POST_CREATED
  FORUM_COMMENT_CREATED
  
  // Reputation activities
  BADGE_EARNED
  LEVEL_UP
}

model BountyDiscussion {
  id        String   @id @default(cuid())
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  bountyId String @map("bounty_id")
  bounty   Bounty @relation(fields: [bountyId], references: [id], onDelete: Cascade)

  authorId String @map("author_id")
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  replies   DiscussionReply[]
  reactions DiscussionReaction[]

  @@index([bountyId, createdAt])
  @@index([authorId])
  @@map("bounty_discussions")
}

model ProjectDiscussion {
  id        String   @id @default(cuid())
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  authorId String @map("author_id")
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  replies   DiscussionReply[]
  reactions DiscussionReaction[]

  @@index([projectId, createdAt])
  @@index([authorId])
  @@map("project_discussions")
}

// Discussion Reply (works for both bounty and project discussions)
model DiscussionReply {
  id        String   @id @default(cuid())
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Can belong to either a bounty discussion or project discussion
  bountyDiscussionId  String?           @map("bounty_discussion_id")
  bountyDiscussion    BountyDiscussion? @relation(fields: [bountyDiscussionId], references: [id], onDelete: Cascade)
  projectDiscussionId String?           @map("project_discussion_id")
  projectDiscussion   ProjectDiscussion? @relation(fields: [projectDiscussionId], references: [id], onDelete: Cascade)

  authorId String @map("author_id")
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Self-referential for nested replies
  parentId String?          @map("parent_id")
  parent   DiscussionReply? @relation("ReplyToReply", fields: [parentId], references: [id], onDelete: Cascade)
  replies  DiscussionReply[] @relation("ReplyToReply")

  reactions DiscussionReaction[]

  @@index([bountyDiscussionId, createdAt])
  @@index([projectDiscussionId, createdAt])
  @@index([authorId])
  @@index([parentId])
  @@map("discussion_replies")
}

// Discussion Reaction (works for discussions and replies)
model DiscussionReaction {
  id        String   @id @default(cuid())
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")

  // Can react to bounty discussion, project discussion, or reply
  bountyDiscussionId  String?           @map("bounty_discussion_id")
  bountyDiscussion    BountyDiscussion? @relation(fields: [bountyDiscussionId], references: [id], onDelete: Cascade)
  projectDiscussionId String?           @map("project_discussion_id")
  projectDiscussion   ProjectDiscussion? @relation(fields: [projectDiscussionId], references: [id], onDelete: Cascade)
  replyId             String?           @map("reply_id")
  reply               DiscussionReply?  @relation(fields: [replyId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bountyDiscussionId, userId, emoji])
  @@unique([projectDiscussionId, userId, emoji])
  @@unique([replyId, userId, emoji])
  @@index([bountyDiscussionId])
  @@index([projectDiscussionId])
  @@index([replyId])
  @@index([userId])
  @@map("discussion_reactions")
}

// User Review Model
model UserReview {
  id        String   @id @default(cuid())
  rating    Float // 1-5 stars, can be decimal
  message   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  reviewerId String @map("reviewer_id")
  reviewer   User   @relation("ReviewGiver", fields: [reviewerId], references: [id], onDelete: Cascade)

  reviewedUserId String @map("reviewed_user_id")
  reviewedUser   User   @relation("ReviewReceiver", fields: [reviewedUserId], references: [id], onDelete: Cascade)

  @@unique([reviewerId, reviewedUserId]) // One review per user pair
  @@index([reviewedUserId])
  @@index([reviewerId])
  @@index([rating])
  @@map("user_reviews")
}
